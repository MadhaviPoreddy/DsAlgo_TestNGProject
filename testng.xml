<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParallelByClasses" parallel="classes" thread-count="3">
<listeners>
 		<listener class-name="com.dsalgo.automation.listener.RetryListener" />
		<listener class-name="com.dsalgo.automation.listener.AllureRptListener" />
		<listener class-name="com.dsalgo.automation.listener.ExtentRptListener" />
	    <listener class-name="com.aventstack.chaintest.plugins.ChainTestListener"/>
	    <listener class-name="com.dsalgo.automation.utils.ScreenshotListener"/>
</listeners>
	<!--	Cross Browser Tesing & parallel Testing -->
	<!-- Chrome Test -->
	<test name="CrossBrowserTests-Chrome">
		<parameter name="browser" value="chrome" />
		<classes>
		  <class name="com.dsalgo.automation.tests.HomePageTest"/>
          <class name="com.dsalgo.automation.tests.LoginPageTest"/>
          <class name="com.dsalgo.automation.tests.DataStructureTest"/>
          <class name="com.dsalgo.automation.tests.GraphPageTest"/>
 	      <class name="com.dsalgo.automation.tests.QueuePageTest"></class> 
          <class name="com.dsalgo.automation.tests.RegisterPageTest"></class>  
	  	  <class name="com.dsalgo.automation.tests.TreePageTest"></class> 
	  	  <class name="com.dsalgo.automation.tests.ArrayPageTest"></class>
	  	  <class name="com.dsalgo.automation.tests.LinkedListPageTest"></class>
  	  	  <class name="com.dsalgo.automation.tests.StackPageTest"></class>
		</classes>
	</test>

	<!-- Firefox Test -->
	 <test name="CrossBrowserTests-Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
		  <class name="com.dsalgo.automation.tests.HomePageTest"/>
          <class name="com.dsalgo.automation.tests.LoginPageTest"/>
          <class name="com.dsalgo.automation.tests.DataStructureTest"/>
          <class name="com.dsalgo.automation.tests.GraphPageTest"/>
 	      <class name="com.dsalgo.automation.tests.QueuePageTest"></class> 
          <class name="com.dsalgo.automation.tests.RegisterPageTest"></class>  
	  	  <class name="com.dsalgo.automation.tests.TreePageTest"></class> 
	  	  <class name="com.dsalgo.automation.tests.ArrayPageTest"></class>
	  	  <class name="com.dsalgo.automation.tests.LinkedListPageTest"></class>
  	  	  <class name="com.dsalgo.automation.tests.StackPageTest"></class>
        </classes>
    </test> 

	<!-- Edge Test--> 
	 <test name="CrossBrowserTests-Edge">
        <parameter name="browser" value="edge"/>
        <classes>
		  <class name="com.dsalgo.automation.tests.HomePageTest"/>
          <class name="com.dsalgo.automation.tests.LoginPageTest"/>
          <class name="com.dsalgo.automation.tests.DataStructureTest"/>
          <class name="com.dsalgo.automation.tests.GraphPageTest"/>
 	      <class name="com.dsalgo.automation.tests.QueuePageTest"></class> 
          <class name="com.dsalgo.automation.tests.RegisterPageTest"></class>  
	  	  <class name="com.dsalgo.automation.tests.TreePageTest"></class> 
	  	  <class name="com.dsalgo.automation.tests.ArrayPageTest"></class>
	  	  <class name="com.dsalgo.automation.tests.LinkedListPageTest"></class>
  	  	  <class name="com.dsalgo.automation.tests.StackPageTest"></class>
        </classes>
    </test> 

</suite>